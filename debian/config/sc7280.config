# Qualcomm Snapdragon SC7280 config fragment

# Display
CONFIG_DRM_PANEL_RAYDIUM_RM692E5=m
CONFIG_DRM_PANEL_SHIFT_SH8804B=m
CONFIG_DRM_PANEL_VISIONOX_RM692E5=m

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=m
CONFIG_TOUCHSCREEN_FTS=m
CONFIG_RMI4_I2C=m
CONFIG_RMI4_SPI=m
CONFIG_RMI4_SMB=m
CONFIG_HID_GOODIX_SPI=m

# Haptics
CONFIG_INPUT_AW86927=m

# Camera
CONFIG_VIDEO_IMX471=m
CONFIG_VIDEO_IMX858=m
CONFIG_VIDEO_S5KJN1=m
CONFIG_VIDEO_DW9719=m

# Clocks
CONFIG_SC_CAMCC_7280=y
CONFIG_SC_DISPCC_7280=y
CONFIG_SC_GPUCC_7280=y
CONFIG_SC_LPASSCC_7280=y
CONFIG_SC_LPASS_CORECC_7280=y
CONFIG_SC_VIDEOCC_7280=y

# Graphics
CONFIG_BACKLIGHT_QCOM_WLED=m
CONFIG_LCD_CLASS_DEVICE=m

# I2C system bus drivers
CONFIG_I2C_QCOM_CCI=y
CONFIG_I2C_QCOM_GENI=y

# Sound
CONFIG_SND_SOC_USB=m
CONFIG_SND_USB_AUDIO_QMI=m
CONFIG_SND_SOC_QDSP6_USB=m
CONFIG_SND_SOC_AW88261=m
CONFIG_SND_SOC_TFA9872=m

# USB
CONFIG_USB_ULPI_BUS=y
CONFIG_USB_XHCI_SIDEBAND=y
CONFIG_TYPEC_MUX_FSA4480=m
CONFIG_TYPEC_MUX_PTN36502=m

# LEDs
CONFIG_LEDS_QCOM_FLASH=m

###########################################################################
#
# Disable unused options to minimize kernel size
#
###########################################################################

# This introduces some weird race conditions.
# Stick to the userspace one for now
CONFIG_QCOM_PD_MAPPER=n

#
# Remove unused features/subsystems
#
CONFIG_EXPERT=n
CONFIG_ACPI=n
CONFIG_ATA=n
CONFIG_PCI=n

#
# CPU IDLE has to be explicitly enabled here,
# because previously it was selected by
# CONFIG_ACPI, which is off now
#
CONFIG_CPU_IDLE=y

#
# Remove unused platforms
#
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BITMAIN=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n
