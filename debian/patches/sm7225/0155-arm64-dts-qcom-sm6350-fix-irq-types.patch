From: Luca Weiss <luca.weiss@fairphone.com>
Date: Fri, 11 Nov 2022 11:43:54 +0100
Subject: arm64: dts: qcom: sm6350: fix irq types?

Use types that are hardcoded requested in the drivers there.

Avoid errors like
[    2.178003] irq: type mismatch, failed to map hwirq-14 for interrupt-controller@b220000!

See also https://lore.kernel.org/lkml/8735gi5g7s.wl-maz@kernel.org/
---
 arch/arm64/boot/dts/qcom/sm6350.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6350.dtsi b/arch/arm64/boot/dts/qcom/sm6350.dtsi
index b734309..8124b5f 100644
--- a/arch/arm64/boot/dts/qcom/sm6350.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6350.dtsi
@@ -1905,8 +1905,8 @@ usb_1: usb@a6f8800 {
 
 			interrupts-extended = <&intc GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>,
 					      <&pdc 17 IRQ_TYPE_LEVEL_HIGH>,
-					      <&pdc 15 IRQ_TYPE_EDGE_BOTH>,
-					      <&pdc 14 IRQ_TYPE_EDGE_BOTH>;
+					      <&pdc 15 IRQ_TYPE_LEVEL_HIGH>,
+					      <&pdc 14 IRQ_TYPE_LEVEL_HIGH>;
 
 			interrupt-names = "hs_phy_irq", "ss_phy_irq",
 					  "dm_hs_phy_irq", "dp_hs_phy_irq";
