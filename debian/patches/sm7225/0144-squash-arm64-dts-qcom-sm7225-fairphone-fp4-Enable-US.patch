From: Luca Weiss <luca.weiss@fairphone.com>
Date: Fri, 22 Mar 2024 14:12:57 +0100
Subject: squash! arm64: dts: qcom: sm7225-fairphone-fp4: Enable USB role
 switching

---
 arch/arm64/boot/dts/qcom/sm6350.dtsi              | 28 +++++++++++++++++++----
 arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts | 20 +++++++++++-----
 2 files changed, 38 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6350.dtsi b/arch/arm64/boot/dts/qcom/sm6350.dtsi
index 4c317d05..fb4c8da 100644
--- a/arch/arm64/boot/dts/qcom/sm6350.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6350.dtsi
@@ -1730,17 +1730,22 @@ ports {
 				port@0 {
 					reg = <0>;
 
-					usb_1_qmpphy_out: endpoint {};
+					usb_1_qmpphy_out: endpoint {
+					};
 				};
 
 				port@1 {
 					reg = <1>;
+
+					usb_1_qmpphy_usb_ss_in: endpoint {
+					};
 				};
 
 				port@2 {
 					reg = <2>;
 
-					usb_1_qmpphy_dp_in: endpoint {};
+					usb_1_qmpphy_dp_in: endpoint {
+					};
 				};
 			};
 		};
@@ -1916,8 +1921,23 @@ usb_1_dwc3: usb@a600000 {
 				phys = <&usb_1_hsphy>, <&usb_1_qmpphy QMP_USB43DP_USB3_PHY>;
 				phy-names = "usb2-phy", "usb3-phy";
 
-				port {
-					usb_1_role_switch_out: endpoint {};
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					port@0 {
+						reg = <0>;
+
+						usb_1_dwc3_hs_out: endpoint {
+						};
+					};
+
+					port@1 {
+						reg = <1>;
+
+						usb_1_dwc3_ss_out: endpoint {
+						};
+					};
 				};
 			};
 		};
diff --git a/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts b/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts
index 5d8f532..58c15a9 100644
--- a/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts
+++ b/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts
@@ -816,14 +816,14 @@ ports {
 
 			port@0 {
 				reg = <0>;
-				pm7250b_role_switch_in: endpoint {
-					remote-endpoint = <&usb_1_role_switch_out>;
+				pm7250b_hs_in: endpoint {
+					remote-endpoint = <&usb_1_dwc3_hs_out>;
 				};
 			};
 
 			port@1 {
 				reg = <1>;
-				pm7250b_typec_mux_in: endpoint {
+				pm7250b_ss_in: endpoint {
 					remote-endpoint = <&usb_1_qmpphy_out>;
 				};
 			};
@@ -1134,8 +1134,12 @@ &usb_1_dwc3 {
 	usb-role-switch;
 };
 
-&usb_1_role_switch_out {
-	remote-endpoint = <&pm7250b_role_switch_in>;
+&usb_1_dwc3_hs_out {
+	remote-endpoint = <&pm7250b_hs_in>;
+};
+
+&usb_1_dwc3_ss_out {
+	remote-endpoint = <&usb_1_qmpphy_usb_ss_in>;
 };
 
 &usb_1_hsphy {
@@ -1155,7 +1159,11 @@ &usb_1_qmpphy {
 };
 
 &usb_1_qmpphy_out {
-	remote-endpoint = <&pm7250b_typec_mux_in>;
+	remote-endpoint = <&pm7250b_ss_in>;
+};
+
+&usb_1_qmpphy_usb_ss_in {
+	remote-endpoint = <&usb_1_dwc3_ss_out>;
 };
 
 &wifi {
