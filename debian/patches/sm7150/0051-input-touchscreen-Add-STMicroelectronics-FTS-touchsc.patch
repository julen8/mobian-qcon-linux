+			logError(0, "%s %s Proximity Detected!\n", tag,
+				 __func__);
+		break;
+
+	default:
+		logError(
+			0,
+			"%s %s Received unhandled user report event = %02X %02X %02X %02X %02X %02X %02X %02X\n",
+			tag, __func__, event[0], event[1], event[2], event[3],
+			event[4], event[5], event[6], event[7]);
+		break;
+	}
+}
