From: Eugene Lepshy <fekz115@gmail.com>
Date: Thu, 11 Jan 2024 14:51:47 +0300
Subject: arm64: dts: qcom: sm7325-nothing-spacewar: Add touchscreen support

Signed-off-by: Eugene Lepshy <fekz115@gmail.com>
---
 .../boot/dts/qcom/sm7325-nothing-spacewar.dts      | 67 +++++++++++++++++++++-
 1 file changed, 65 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts b/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
index 66f3a25..a1ba961 100644
--- a/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
+++ b/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
@@ -536,7 +536,10 @@ regulators-1 {
 
 		vdd-l1-l12-supply = <&vreg_s1b_1p856>;
 		vdd-l2-l8-supply = <&vreg_s1b_1p856>;
-		vdd-l3-l4-l5-l7-l13-supply = <&vreg_bob>;
+		/*
+		 * Doesn't work with always-on TS regulators :/
+		 * vdd-l3-l4-l5-l7-l13-supply = <&vreg_bob>;
+		 */
 		vdd-l6-l9-l11-supply = <&vreg_bob>;
 		vdd-l10-supply = <&vreg_s7b_0p952>;
 
@@ -598,6 +601,7 @@ vreg_l3c_3p0: ldo3 {
 			regulator-min-microvolt = <2800000>;
 			regulator-max-microvolt = <3540000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
 		};
 
 		vdd_px5:
@@ -638,6 +642,7 @@ vreg_l8c_1p8: ldo8 {
 			regulator-min-microvolt = <1620000>;
 			regulator-max-microvolt = <2000000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
 		};
 
 		vreg_l9c_2p96: ldo9 {
@@ -1171,7 +1176,39 @@ codec {
 &spi13 {
 	status = "okay";
 
-	/* focaltech,ft3680 (Touchscreen) @ 0 */
+	focaltech@0 {
+		compatible = "focaltech,fts_ts";
+		reg = <0x0>;
+
+		spi-max-frequency = <6000000>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <81 0x2008>;
+		focaltech,reset-gpio = <&tlmm 105 GPIO_ACTIVE_HIGH>;
+		focaltech,irq-gpio = <&tlmm 81 0x2008>;
+		focaltech,display-coords = <0 0 1080 2400>;
+		focaltech,max-touch-number = <10>;
+		focaltech,ic-type = <0x3658d488>;
+
+		vdd-supply = <&vdd_ts>;
+		iovdd-supply = <&vreg_l8c_1p8>;
+
+		pinctrl-0 = <&ts_active>;
+		pinctrl-1 = <&ts_release>;
+		pinctrl-2 = <&ts_suspend>;
+		pinctrl-names = "pmx_ts_active",
+				"pmx_ts_release",
+				"pmx_ts_suspend";
+		focaltech,trusted-touch-mode = "vm_mode";
+		focaltech,touch-environment = "pvm";
+		focaltech,trusted-touch-spi-irq = <601>;
+		focaltech,trusted-touch-io-bases = <0xf134000 0xf135000
+						    0xf136000 0xf137000
+						    0xf169000 0xf151000
+						    0xa94000 0x00a10000>;
+		focaltech,trusted-touch-io-sizes = <0x1000 0x1000 0x1000 0x1000
+						    0x1000 0x1000 0x1000 0x4000>;
+	};
 };
 
 &tlmm {
@@ -1296,6 +1333,32 @@ pri_mi2s_sleep: pri-mi2s-sleep-state {
 		bias-pull-down;
 		input-enable;
 	};
+
+	/*
+	 * Schematic names:
+	 * gpio81  - ts_int_n
+	 * gpio105 - ts_reset_n
+	 */
+	ts_active: ts-active-state {
+		pins = "gpio81", "gpio105";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	ts_release: ts_release-state {
+		pins = "gpio81", "gpio105";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	ts_suspend: ts-suspend-state {
+		pins = "gpio81", "gpio105";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
 };
 
 &uart5 {
