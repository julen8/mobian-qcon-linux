From: Luca Weiss <luca.weiss@fairphone.com>
Date: Thu, 17 Aug 2023 14:45:18 +0200
Subject: arm64: dts: qcom: qcm6490-fairphone-fp5: Camera mclk and regulator
 force on

---
 arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts | 58 ++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts b/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts
index a7af386..3e739dc 100644
--- a/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts
+++ b/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts
@@ -113,6 +113,7 @@ ois_avdd0_1p8: regulator-ois-avdd0-1p8 {
 		gpio = <&tlmm 157 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 		vin-supply = <&vreg_bob>;
+		regulator-always-on; // FIXME
 	};
 
 	ois_dvdd_1p1: regulator-ois-dvdd-1p1 {
@@ -123,6 +124,7 @@ ois_dvdd_1p1: regulator-ois-dvdd-1p1 {
 		gpio = <&tlmm 97 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 		vin-supply = <&vreg_s8b>;
+		regulator-always-on; // FIXME
 	};
 
 	afvdd_2p8: regulator-afvdd-2p8 {
@@ -133,6 +135,34 @@ afvdd_2p8: regulator-afvdd-2p8 {
 		gpio = <&tlmm 68 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 		vin-supply = <&vreg_bob>;
+		regulator-always-on; // FIXME
+	};
+
+	fake-reg-mclk0 {
+		compatible = "regulator-fixed-clock";
+		regulator-name = "fake-reg-mclk0";
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk0_default>;
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		regulator-always-on;
+	};
+
+	fake-reg-mclk1 {
+		compatible = "regulator-fixed-clock";
+		regulator-name = "fake-reg-mclk1";
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk1_default>;
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		regulator-always-on;
+	};
+
+	fake-reg-mclk3 {
+		compatible = "regulator-fixed-clock";
+		regulator-name = "fake-reg-mclk3";
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk3_default>;
+		clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		regulator-always-on;
 	};
 };
 
@@ -474,6 +504,7 @@ &pm8008_l1 {
 	regulator-min-microvolt = <1000000>;
 	regulator-max-microvolt = <1200000>;
 	regulator-min-dropout-voltage-microvolt = <160000>;
+	regulator-always-on; // FIXME
 };
 
 &pm8008_l2 {
@@ -483,18 +514,21 @@ since current_uV on boot is 1.2V, but the regulator steps don't
 	   include exactly 1.15V, just 1.152V */
 	regulator-max-microvolt = <1152000>;
 	regulator-min-dropout-voltage-microvolt = <128000>;
+	regulator-always-on; // FIXME
 };
 
 &pm8008_l3 {
 	regulator-min-microvolt = <2700000>;
 	regulator-max-microvolt = <3000000>;
 	regulator-min-dropout-voltage-microvolt = <144000>;
+	regulator-always-on; // FIXME
 };
 
 &pm8008_l4 {
 	regulator-min-microvolt = <2700000>;
 	regulator-max-microvolt = <2900000>;
 	regulator-min-dropout-voltage-microvolt = <128000>;
+	regulator-always-on; // FIXME
 };
 
 &pm8008_l5 {
@@ -502,6 +536,7 @@ &pm8008_l5 {
 	regulator-min-microvolt = <2704000>;
 	regulator-max-microvolt = <2900000>;
 	regulator-min-dropout-voltage-microvolt = <128000>;
+	regulator-always-on; // FIXME
 };
 
 &pm8008_l6 {
@@ -509,12 +544,14 @@ &pm8008_l6 {
 	/* Downstream max voltage: 1.9V. See comment at pm8008_l2 */
 	regulator-max-microvolt = <1904000>;
 	regulator-min-dropout-voltage-microvolt = <136000>;
+	regulator-always-on; // FIXME CCI pull-up regulator
 };
 
 &pm8008_l7 {
 	regulator-min-microvolt = <2700000>;
 	regulator-max-microvolt = <3000000>;
 	regulator-min-dropout-voltage-microvolt = <312000>;
+	regulator-always-on; // FIXME
 };
 
 &pm8350c_flash {
@@ -669,6 +706,27 @@ bluetooth_enable_default: bluetooth-enable-default-state {
 		bias-disable;
 	};
 
+	cam_mclk0_default: cam-mclk0-default-state {
+		pins = "gpio64";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk1_default: cam-mclk1-default-state {
+		pins = "gpio65";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk3_default: cam-mclk3-default-state {
+		pins = "gpio67";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	hall_sensor_default: hall-sensor-default-state {
 		pins = "gpio155";
 		function = "gpio";
