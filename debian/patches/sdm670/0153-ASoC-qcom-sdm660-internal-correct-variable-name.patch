From: Richard Acayan <mailingradian@gmail.com>
Date: Tue, 3 Feb 2026 22:24:36 -0500
Subject: ASoC: qcom: sdm660-internal: correct variable name

Amends: ASoC: qcom: add sdm660 internal sound card support
Signed-off-by: Richard Acayan <mailingradian@gmail.com>
---
 sound/soc/qcom/sdm660-internal.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/sound/soc/qcom/sdm660-internal.c b/sound/soc/qcom/sdm660-internal.c
index 98f5eaf..9bf3489 100644
--- a/sound/soc/qcom/sdm660-internal.c
+++ b/sound/soc/qcom/sdm660-internal.c
@@ -115,7 +115,7 @@ static int snd_sdm660_int_startup(struct snd_pcm_substream *stream)
 		break;
 	default:
 		dev_err(rtd->dev, "%s: invalid dai id 0x%x\n", __func__,
-			cpu_dai->id);
+			cpu->id);
 		return -EINVAL;
 	}
 
@@ -163,7 +163,7 @@ static void snd_sdm660_int_shutdown(struct snd_pcm_substream *stream)
 		break;
 	default:
 		dev_err(rtd->dev, "%s: invalid dai id 0x%x\n", __func__,
-			cpu_dai->id);
+			cpu->id);
 		break;
 	}
 }
