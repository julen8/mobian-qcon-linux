-	firmware-name = "qcom/qcm6490/fairphone5/a660_zap.mdt";
+	firmware-name = "qcom/qcm6490/fairphone5/a660_zap.mbn";
 };
 
 &i2c1 {
@@ -699,7 +699,7 @@ &i2c9 {
 &ipa {
 	qcom,gsi-loader = "self";
 	memory-region = <&ipa_fw_mem>;
-	firmware-name = "qcom/qcm6490/fairphone5/ipa_fws.mdt";
