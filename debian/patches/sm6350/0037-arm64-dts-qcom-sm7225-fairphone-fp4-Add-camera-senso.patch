From: Luca Weiss <luca.weiss@fairphone.com>
Date: Fri, 11 Nov 2022 16:43:43 +0100
Subject: arm64: dts: qcom: sm7225-fairphone-fp4: Add camera sensors &
 actuators

Signed-off-by: Luca Weiss <luca.weiss@fairphone.com>
---
 arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts | 167 +++++++++++++++++++++-
 1 file changed, 164 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts b/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts
index 2bad343..1898e95 100644
--- a/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts
+++ b/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts
@@ -17,6 +17,7 @@
 #include <dt-bindings/iio/qcom,spmi-adc7-pmk8350.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/leds/common.h>
+#include <dt-bindings/media/video-interfaces.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
 #include <dt-bindings/sound/qcom,q6asm.h>
@@ -547,13 +548,84 @@ vreg_bob: bob {
 	};
 };
 
+&camss {
+	vdda-0.9-supply = <&vreg_l18a>;
+	vdda-1.25-supply = <&vreg_l22a>;
+
+	status = "okay";
+
+	ports {
+		port@0 {
+			csiphy0_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&camera_imx582_uw_ep>;
+			};
+		};
+
+		port@2 {
+			csiphy2_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&camera_imx582_ep>;
+			};
+		};
+
+		port@3 {
+			csiphy3_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&camera_imx576_ep>;
+			};
+		};
+	};
+};
+
 &cci0 {
 	status = "okay";
 };
 
 &cci0_i2c0 {
-	/* Main cam (Sony IMX582) @ 0x1a */
+	/* Main cam */
+	camera@1a {
+		compatible = "sony,imx582";
+		reg = <0x1a>;
+
+		vdig-supply = <&vreg_l2p>;
+		vana1-supply = <&vreg_l5p>;
+		vana2-supply = <&vreg_48m_ois_avdd0_1p8>;
+		vif-supply = <&vreg_l6p>;
+
+		clocks = <&camcc CAMCC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAMCC_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk0_default>;
+		pinctrl-names = "default";
+
+		orientation = <1>; /* Rear facing */
+		rotation = <270>;
+
+		//lens-focus = <&camera_imx582_lc898219xi>;
+
+		port {
+			camera_imx582_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				link-frequencies = /bits/ 64 <600000000>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
+	};
+
 	/* VCM driver (Onsemi LC898219XI) @ 0x28 */
+	camera_imx582_lc898219xi: actuator@28 {
+		compatible = "onsemi,lc898219xi";
+		reg = <0x28>;
+		vdd-supply = <&vreg_l7p>;
+	};
+
 	/* OIS driver (CML CM401) @ 0x30 */
 
 	eeprom@50 {
@@ -566,7 +638,48 @@ eeprom@50 {
 
 &cci0_i2c1 {
 	/* VCM driver (Dongwoon DW9800W) @ 0xc */
-	/* Ultra-wide cam (Sony IMX582) @ 0x1a */
+	camera_imx582_uw_dw9800w: actuator@c {
+		compatible = "dongwoon,dw9800w";
+		reg = <0x0c>;
+		vdd-supply = <&vreg_ois_2p8>;
+
+		dongwoon,sac-mode = <1>;
+		//dongwoon,vcm-prescale = <58>; // FIXME DIV=0x01
+		dongwoon,vcm-prescale = <0x7a>; // FIXME upper two bits are DIV[1:0]
+	};
+
+	/* Ultra-wide cam */
+	camera@1a {
+		compatible = "sony,imx582";
+		reg = <0x1a>;
+
+		vdig-supply = <&vreg_l1p>;
+		vana1-supply = <&vreg_l4p>;
+		vana2-supply = <&vreg_48m_uw_avdd0_1p8>;
+		vif-supply = <&vreg_l6p>;
+
+		clocks = <&camcc CAMCC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAMCC_MCLK2_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 36 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk2_default>;
+		pinctrl-names = "default";
+
+		orientation = <1>; /* Rear facing */
+		rotation = <270>;
+
+		//lens-focus = <&camera_imx582_uw_dw9800w>;
+
+		port {
+			camera_imx582_uw_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				link-frequencies = /bits/ 64 <600000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
 
 	eeprom@50 {
 		compatible = "giantec,gt24p64a", "atmel,24c64";
@@ -581,7 +694,34 @@ &cci1 {
 };
 
 &cci1_i2c0 {
-	/* Front cam (Sony IMX576) @ 0x10 */
+	camera@10 {
+		compatible = "sony,imx576";
+		reg = <0x10>;
+
+		vana-supply = <&vreg_l3p>;
+		vdig-supply = <&vreg_32m_cam_dvdd_1p05>;
+		vif-supply = <&vreg_l6p>;
+
+		clocks = <&camcc CAMCC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAMCC_MCLK1_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk1_default>;
+		pinctrl-names = "default";
+
+		orientation = <0>; /* Front facing */
+		rotation = <90>;
+
+		port {
+			camera_imx576_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				link-frequencies = /bits/ 64 <600000000>;
+				remote-endpoint = <&csiphy3_ep>;
+			};
+		};
+	};
 
 	eeprom@50 {
 		compatible = "giantec,gt24p64a", "atmel,24c64";
@@ -1151,6 +1291,27 @@ platform {
 &tlmm {
 	gpio-reserved-ranges = <13 4>, <56 2>;
 
+	cam_mclk0_default: cam-mclk0-default-state {
+		pins = "gpio29";
+		function = "cam_mclk0";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk1_default: cam-mclk1-default-state {
+		pins = "gpio30";
+		function = "cam_mclk1";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_mclk2_default: cam-mclk2-default-state {
+		pins = "gpio31";
+		function = "cam_mclk2";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	qup_uart1_sleep_cts: qup-uart1-sleep-cts-state {
 		pins = "gpio61";
 		function = "gpio";
