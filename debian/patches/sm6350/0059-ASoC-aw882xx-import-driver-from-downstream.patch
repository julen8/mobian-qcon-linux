+	int ret;
+
+	ret = aw882xx_append_suffix("%s_%s", &debugfs_dir, aw882xx);
+	if (ret < 0)
+		return;
+
+	dbg_fs->dbg_dir = debugfs_create_dir(debugfs_dir, NULL);
+	if (dbg_fs->dbg_dir == NULL) {
+		aw_dev_err(aw882xx->dev, "create cali debugfs failed !\n");
+		return;
