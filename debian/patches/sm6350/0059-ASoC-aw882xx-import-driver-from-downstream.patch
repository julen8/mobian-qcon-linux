+			len += snprintf(buf+len, PAGE_SIZE - len,
+				"f0:%d q:%d\n", data.right_f0, data.right_q);
+		} else {
+			aw_dev_err(aw882xx->dev, "%s: channel:%d unsupported\n",
+					__func__, aw882xx->chan_info.channel);
