+struct soc_mixer_control aw882xx_mixer = {
+	.reg	= AW882XX_HAGCCFG4_REG,
+	.shift	= AW882XX_VOL_START_BIT,
+	.max	= AW882XX_VOLUME_MAX,
+	.min	= AW882XX_VOLUME_MIN,
+};
