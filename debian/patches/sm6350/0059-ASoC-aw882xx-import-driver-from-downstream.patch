+	dbg_fs->dbg_range = debugfs_create_file("range", S_IFREG|S_IRUGO,
+			dbg_fs->dbg_dir, aw882xx, &aw_cali_range_fops);
+	if (dbg_fs->dbg_range == NULL) {
+		aw_dev_err(aw882xx->dev, "create cali debugfs range failed !\n");
