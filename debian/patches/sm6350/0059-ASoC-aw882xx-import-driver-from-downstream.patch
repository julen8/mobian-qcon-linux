+/***************dsp communicate**************/
+#ifdef AW_MTK_PLATFORM
+extern int mtk_spk_send_ipi_buf_to_dsp(void *data_buffer, uint32_t data_size);
+extern int mtk_spk_recv_ipi_buf_from_dsp(int8_t *buffer, int16_t size, uint32_t *buf_len);
