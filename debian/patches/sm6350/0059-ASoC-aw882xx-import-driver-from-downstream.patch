+
+static const uint32_t PARAM_ID_INDEX_TABLE[][INDEX_PARAMS_ID_MAX] = {
+	{
+		AFE_PARAM_ID_AWDSP_RX_PARAMS,
+		AFE_PARAM_ID_AWDSP_RX_SET_ENABLE,
