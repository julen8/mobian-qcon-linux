+int  aw_cali_status_open(struct inode *inode, struct file *file)
+{
+	struct aw882xx *aw882xx = (struct aw882xx *)inode->i_private;
+
+	file->private_data = (void *)aw882xx;
+	aw_dev_dbg(aw882xx->dev, "%s: open success\n", __func__);
