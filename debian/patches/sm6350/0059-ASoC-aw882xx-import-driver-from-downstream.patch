+	(~(((1<<AW882XX_TX_THRS_BITS_LEN)-1)<<AW882XX_TX_THRS_START_BIT))
+
+#define AW882XX_TX_THRS_DEFAULT_VALUE	(1)
+#define AW882XX_TX_THRS_DEFAULT			\
+	(AW882XX_TX_THRS_DEFAULT_VALUE<<AW882XX_TX_THRS_START_BIT)
+
+/* VDSEL bit 3 (I2SCFG2 0x08) */
+#define AW882XX_VDSEL_START_BIT			(3)
+#define AW882XX_VDSEL_BITS_LEN			(1)
+#define AW882XX_VDSEL_MASK				\
+	(~(((1<<AW882XX_VDSEL_BITS_LEN)-1)<<AW882XX_VDSEL_START_BIT))
+
+#define AW882XX_VDSEL_DAC_DATA			(0)
+#define AW882XX_VDSEL_DAC_DATA_VALUE	\
+	(AW882XX_VDSEL_DAC_DATA << AW882XX_VDSEL_START_BIT)
+#define AW882XX_VDSEL_VSENSE_DATA		(1)
+#define AW882XX_VDSEL_VSENSE_DATA_VALUE	\
+	(AW882XX_VDSEL_VSENSE_DATA << AW882XX_VDSEL_START_BIT)
+
+#define AW882XX_VDSEL_DEFAULT_VALUE		(0)
+#define AW882XX_VDSEL_DEFAULT			\
+	(AW882XX_VDSEL_DEFAULT_VALUE<<AW882XX_VDSEL_START_BIT)
+
+/* IV2CH bit 2 (I2SCFG2 0x08) */
+#define AW882XX_IV2CH_START_BIT			(2)
+#define AW882XX_IV2CH_BITS_LEN			(1)
+#define AW882XX_IV2CH_MASK				\
+	(~(((1<<AW882XX_IV2CH_BITS_LEN)-1)<<AW882XX_IV2CH_START_BIT))
+
+#define AW882XX_IV2CH_LEGACY_MODE		(0)
+#define AW882XX_IV2CH_LEGACY_MODE_VALUE	\
+	(AW882XX_IV2CH_LEGACY_MODE << AW882XX_IV2CH_START_BIT)
+#define AW882XX_IV2CH_16BITS_PER_CHANNEL	(1)
+#define AW882XX_IV2CH_16BITS_PER_CHANNEL_VALUE	\
+	(AW882XX_IV2CH_16BITS_PER_CHANNEL << AW882XX_IV2CH_START_BIT)
+
+#define AW882XX_IV2CH_DEFAULT_VALUE		(0)
+#define AW882XX_IV2CH_DEFAULT			\
+	(AW882XX_IV2CH_DEFAULT_VALUE<<AW882XX_IV2CH_START_BIT)
+
+/* default value of I2SCFG2 (0x08) */
+/* #define  AW882XX_I2SCFG2_DEFAULT		(0x2100) */
+
+
+/* HAGCCFG4 (0x0C) detail */
+/* VOL bit 15:8 (HAGCCFG4 0x0C) */
+#define AW882XX_VOL_START_BIT			(8)
+#define AW882XX_VOL_BITS_LEN			(8)
+#define AW882XX_VOL_MASK				\
+	(~(((1<<AW882XX_VOL_BITS_LEN)-1)<<AW882XX_VOL_START_BIT))
+
+#define AW882XX_VOLUME_MAX				(0)
+#define AW882XX_VOLUME_MIN				(-255)
+
+#define AW882XX_VOL_DEFAULT_VALUE		(0)
+#define AW882XX_VOL_DEFAULT				\
+	(AW882XX_VOL_DEFAULT_VALUE<<AW882XX_VOL_START_BIT)
+
+#define AW882XX_VOL_6DB_STEP		(6 * 2)
+
+/* HOLDTH bit 7:0 (HAGCCFG4 0x0C) */
+#define AW882XX_HOLDTH_START_BIT		(0)
+#define AW882XX_HOLDTH_BITS_LEN			(8)
+#define AW882XX_HOLDTH_MASK				\
+	(~(((1<<AW882XX_HOLDTH_BITS_LEN)-1)<<AW882XX_HOLDTH_START_BIT))
+
+#define AW882XX_HOLDTH_RESERVED			(0)
+#define AW882XX_HOLDTH_RESERVED_VALUE	\
+	(AW882XX_HOLDTH_RESERVED << AW882XX_HOLDTH_START_BIT)
+
+#define AW882XX_HOLDTH_DEFAULT_VALUE	(0x64)
+#define AW882XX_HOLDTH_DEFAULT			\
+	(AW882XX_HOLDTH_DEFAULT_VALUE<<AW882XX_HOLDTH_START_BIT)
+
+/* default value of HAGCCFG4 (0x0C) */
+/* #define  AW882XX_HAGCCFG4_DEFAULT		(0x0064) */
+
+/* #define  AW882XX_TESTDET_DEFAULT		(0x0000) */
+
+
+#define AW882XX_DITHER_EN_START_BIT		(7)
+#define AW882XX_DITHER_EN_BITS_LEN		(1)
+#define AW882XX_DITHER_EN_MASK				\
+	(~(((1<<AW882XX_DITHER_EN_BITS_LEN)-1)<<AW882XX_DITHER_EN_START_BIT))
+
+
+/********************************************
+ * Vcalb
+ *******************************************/
+#define AW882XX_EF_VSN_GESLP_MASK		(0x03ff)
+#define AW882XX_EF_VSN_GESLP_SIGN_MASK	(0x0200)
+#define AW882XX_EF_VSN_GESLP_NEG		(0xfc00)
+
+#define AW882XX_EF_ISN_GESLP_MASK		(0x03ff)
+#define AW882XX_EF_ISN_GESLP_SIGN_MASK	(0x0200)
+#define AW882XX_EF_ISN_GESLP_NEG		(0xfc00)
+
+#define AW882XX_CABL_BASE_VALUE			(1000)
+#define AW882XX_ICABLK_FACTOR			(1)
+#define AW882XX_VCABLK_FACTOR			(1)
+
+#define AW882XX_VCAL_FACTOR				(1<<13)
+
+#endif /* #ifndef __AW882XX_REG_H__ */
