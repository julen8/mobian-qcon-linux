From: Luca Weiss <luca.weiss@fairphone.com>
Date: Fri, 29 Mar 2024 12:12:35 +0100
Subject: arm64: dts: qcom: sm7225-fairphone-fp4: Enable USB-C source & sink

Signed-off-by: Luca Weiss <luca.weiss@fairphone.com>
---
 arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts b/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts
index baad82a..bdab19d 100644
--- a/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts
+++ b/arch/arm64/boot/dts/qcom/sm7225-fairphone-fp4.dts
@@ -1147,13 +1147,25 @@ connector {
 		data-role = "dual";
 		self-powered;
 
+		/* 5V @ 0.5A */
+		source-pdos = <PDO_FIXED(5000, 500,
+					 PDO_FIXED_DUAL_ROLE |
+					 PDO_FIXED_USB_COMM |
+					 PDO_FIXED_DATA_SWAP)>;
+
 		/*
-		 * Disable USB Power Delivery for now, seems to need extra work
-		 * to support role switching while also letting the battery
-		 * charge still - without charger driver
+		 * The sink should also support 9V @ 1.5A and 10V @ 1.5A but we
+		 * need charger support first for this to make sense.
+		 *
+		 *   PDO_FIXED(9000, 1500, 0)
+		 *   PDO_FIXED(10000, 1500, 0)
 		 */
-		typec-power-opmode = "default";
-		pd-disable;
+		sink-pdos = <PDO_FIXED(5000, 2000,
+				       PDO_FIXED_DUAL_ROLE |
+				       PDO_FIXED_USB_COMM |
+				       PDO_FIXED_DATA_SWAP)>;
+
+		op-sink-microwatt = <2500000>;
 
 		ports {
 			#address-cells = <1>;
