From: Joel Selvaraj <foss@joelselvaraj.com>
Date: Mon, 5 Jan 2026 16:50:53 -0600
Subject: sdm845.config: fix pmos kconfig warning and few recommendataions

---
 arch/arm64/configs/sdm845.config | 32 +++++++++++++++++++++++++++++---
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/configs/sdm845.config b/arch/arm64/configs/sdm845.config
index 9b779ac..c04d910 100644
--- a/arch/arm64/configs/sdm845.config
+++ b/arch/arm64/configs/sdm845.config
@@ -347,7 +347,7 @@ CONFIG_EXFAT_FS=m
 CONFIG_CPU_FREQ_GOV_POWERSAVE=y
 CONFIG_SYN_COOKIES=y
 CONFIG_UEVENT_HELPER=y
-CONFIG_INPUT_UINPUT=m
+CONFIG_INPUT_UINPUT=y
 CONFIG_U_SERIAL_CONSOLE=y
 CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
 
@@ -389,6 +389,10 @@ CONFIG_SQUASHFS_XZ=y
 
 # Waydroid
 CONFIG_PSI=y
+CONFIG_IP_NF_MANGLE=m
+
+# Wine
+CONFIG_NTSYNC=m
 
 # WLAN debugging
 CONFIG_ATH10K_DEBUG=y
@@ -434,6 +438,13 @@ CONFIG_NF_TABLES_IPV4=y
 CONFIG_NF_TABLES_IPV6=y
 CONFIG_SND_USB_AUDIO=m
 CONFIG_CIFS=y
+CONFIG_IP_NF_TARGET_REJECT=m
+CONFIG_IP6_NF_FILTER=m
+CONFIG_IP6_NF_TARGET_REJECT=m
+CONFIG_IP6_NF_NAT=m
+CONFIG_IP_NF_IPTABLES_LEGACY=m
+CONFIG_IP6_NF_IPTABLES_LEGACY=m
+CONFIG_NETFILTER_XTABLES_LEGACY=y
 
 CONFIG_DRM_GUD=m
 CONFIG_DRM_UDL=m # For displaylink usb displays
@@ -447,6 +458,11 @@ CONFIG_DUMMY=m
 CONFIG_BLK_DEV_THROTTLING=y
 CONFIG_NET_CLS_CGROUP=m
 CONFIG_IP_NF_TARGET_REDIRECT=m
+CONFIG_IP_NF_FILTER=m
+CONFIG_IP_NF_TARGET_MASQUERADE=m
+CONFIG_IP6_NF_TARGET_MASQUERADE=m
+CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
+CONFIG_IP_NF_NAT=m
 CONFIG_IP_VS=m
 CONFIG_IP_VS_NFCT=y
 CONFIG_IP_VS_PROTO_TCP=y
@@ -460,9 +476,9 @@ CONFIG_CGROUP_NET_PRIO=y
 CONFIG_IPVLAN=m
 
 # pmOS ZRAM kconfig
-CONFIG_ZSMALLOC=m
+CONFIG_ZSMALLOC=y
 CONFIG_ZSMALLOC_STAT=y
-CONFIG_ZRAM=m
+CONFIG_ZRAM=y
 CONFIG_ZRAM_DEF_COMP_ZSTD=y
 CONFIG_ZRAM_DEF_COMP="zstd"
 CONFIG_ZRAM_MEMORY_TRACKING=y
@@ -520,6 +536,16 @@ CONFIG_JOYSTICK_XPAD=m
 CONFIG_JOYSTICK_XPAD_FF=y
 CONFIG_JOYSTICK_XPAD_LEDS=y
 
+# pmos hardening
+CONFIG_CFI=y
+CONFIG_CFI_ICALL_NORMALIZE_INTEGERS=y
+CONFIG_SHADOW_CALL_STACK=y
+
+# pmos immutable
+CONFIG_DM_VERITY=m
+CONFIG_EROFS_FS=y
+CONFIG_EROFS_FS_ZIP=y
+
 # Disable all unrelated stuffs afaik
 CONFIG_ARCH_BLAIZE=n
 CONFIG_ARCH_SPARX5=n
